rules { transfer unequips; wear any; }
location "loc:courtyard" named "Courtyard";
location "loc:shrine" named "Shrine";
character "char:orin" named "Orin" at "loc:courtyard" {
 stat "defense" = 8;
 resource "focus" = 3 min 0 max 5;
 resource "hp" = 9 min 0 max 12;
}
character "char:lyra" named "Lyra" at "loc:courtyard" {
 stat "defense" = 10;
 resource "hp" = 6 min 0 max 20;
 resource "focus" = 1 min 0 max 4;
}
character "char:tess" named "Tess" at "loc:shrine" {
 stat "defense" = 7;
 resource "hp" = 11 min 0 max 15;
 resource "focus" = 2 min 0 max 4;
}
item "item:token" named "Token" { owner "char:orin"; }
relation character "char:orin" "trust" character "char:lyra" = 4;
condition type "condition:guarded" {
 instances unique;
 modifier "ward" stat "defense" add 3;
}
ability "ability:steady-aid" named "Steady Aid" {
 parameter "payer" character;
 parameter "target" character;
 parameter "guard_id" condition_id;
 spend param "payer" resource "focus" by 2;
 heal param "target" resource "hp" by 4;
 apply condition param "guard_id" of "condition:guarded" to param "target" from location "loc:shrine";
}
ability "ability:pay" named "Pay" {
 parameter "payer" character;
 parameter "amount" int;
 spend param "payer" resource "focus" by param "amount";
}
